# DRAFT, not applied. Link-time optimisation (-flto, -flto=thin) for bb10-cxx20.
# Apply in /Users/andreafaggin/own-projects/bb10/bb10-cxx20 with: git apply <this file>
#
# How it works: objects compiled with -flto are LLVM bitcode. The armnto GNU ld (2.45, built with
# plugin support) loads LLVM's linker plugin, /usr/lib/llvm-19/lib/LLVMgold.so, which is already in
# the image, and the plugin generates the code at link time. The driver passes the plugin the code
# generation options that are not stored in bitcode: the CPU, the -O level, emulated TLS, sections.
#
# Tested 2026-11-16 in bb10-cxx20:latest with this driver and toolchain file mounted over the
# image's (a two-file C++ program with an exception, std::string and a thread_local):
#   - full and thin LTO link; the cross-file call is inlined and the unused function is gone
#     (274,580 bytes with --gc-sections against 432,028 without LTO)
#   - bitcode objects link without -flto on the link line; native-only links are unchanged
#   - a shared library links; __emutls_get_address is still used (no ELF TLS relocations)
#   - one PT_ARM_EXIDX segment, same ELF flags as a non-LTO build
#   - CMake: check_ipo_supported says YES and CMAKE_INTERPROCEDURAL_OPTIMIZATION builds a static
#     library plus an executable with -flto=thin (it failed before: no CMAKE_CXX_COMPILER_AR)
#   - archives: llvm-ar works; the armnto ar needs --plugin LLVMgold.so, else "archive has no index"
# Not tested: anything on a phone; the toolchain's own tests/build.sh with this driver; TDLib.
#
# Still to do when applying:
#   1. tests/: an LTO test in build.sh (two files, check the callee is inlined, run on the phone
#      with the exception tests), and the cmake test with IPO on.
#   2. README: an "LTO" paragraph under "Using it"; Makefile users need AR=llvm-ar RANLIB=llvm-ranlib.
#   3. Dockerfile: fail the build if LLVMgold.so is missing (it comes from XIAZY's image today).
#   4. Then in tengram: -DTD_ENABLE_LTO=ON in scripts/build-deps.sh. TDLib's LTO link needs a lot
#      of RAM; thin LTO (what CMake picks for clang) keeps it bounded.
--- a/bin/bb10-clang
+++ b/bin/bb10-clang
@@ -37,6 +37,8 @@
 BINUTILS = "/opt/bb10-toolchain/bin/arm-unknown-nto-qnx6.5.0eabi-"
 BUILTINS = "/opt/bb10-toolchain/lib/libclang_rt.builtins-armv7.a"
 OVERRIDE = "/opt/bb10-target-override/usr/include"
+# LLVM's linker plugin, which lets the armnto GNU ld link bitcode objects (-flto).
+LTO_PLUGIN = os.environ.get("BB10_LTO_PLUGIN", "/usr/lib/llvm-19/lib/LLVMgold.so")
 LIB = TARGET + "/armle-v7/lib"
 USR_LIB = TARGET + "/armle-v7/usr/lib"
 CXX = os.path.basename(sys.argv[0]).endswith("++")
@@ -103,6 +105,29 @@
 IGNORED_LINK = {"-pthread", "-no-pie", "-rdynamic", "-static-libstdc++", "-static-libgcc"}
 
 
+def lto_flags(cflags):
+    """Linker options for link-time optimisation.
+
+    Objects compiled with -flto are LLVM bitcode. GNU ld hands them to LLVM's plugin, which
+    generates the code at link time. The bitcode carries each function's CPU features
+    (-mfpu, -mno-unaligned-access); the plugin must be told again what clang passes to the
+    code generator as options: the CPU, the optimisation level, emulated TLS (QNX 6.6 has
+    no ELF TLS) and sections per function, for --gc-sections.
+
+    The plugin is always loaded, so that bitcode objects link whether or not -flto is
+    repeated on the link line; it does nothing when every input is a native object.
+    """
+    if not os.path.exists(LTO_PLUGIN):
+        return []
+    thin = [a for a in cflags if a.startswith("-flto")][-1:] == ["-flto=thin"]
+    levels = [a[2:] for a in cflags if a.startswith("-O")]
+    level = {"0": "0", "1": "1", "3": "3", "fast": "3"}.get(levels[-1] if levels else "2", "2")
+    opts = ["mcpu=cortex-a9", "O" + level, "-emulated-tls", "-function-sections", "-data-sections"]
+    if thin:
+        opts += ["thinlto", "jobs=%d" % (os.cpu_count() or 1)]
+    return ["-plugin", LTO_PLUGIN] + ["-plugin-opt=" + o for o in opts]
+
+
 def link(args, shared_cxx):
     # Objects, libraries and linker options stay in command-line order, which
     # matters for pairs like -Wl,--whole-archive lib.a -Wl,--no-whole-archive.
@@ -160,6 +185,7 @@
                   "-L" + LIB, "-L" + USR_LIB, "-L" + PREFIX + "/lib",
                   # The ARM unwind tables, which the armnto script leaves out.
                   "-T", PREFIX + "/share/bb10-exidx.ld"]
+        common += lto_flags(cflags)
         # The unwinder goes ahead of the program's libraries: many of the SDK's
         # (libz, libscreen, liblzma, ...) export libgcc's _Unwind_*, and one
         # named first would otherwise supply it, to a libc++abi it crashes.
--- a/cmake/bb10-cxx20.cmake
+++ b/cmake/bb10-cxx20.cmake
@@ -26,3 +26,12 @@
 set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
 set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
 set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+
+# Link-time optimisation (CMAKE_INTERPROCEDURAL_OPTIMIZATION, check_ipo_supported): archives of
+# bitcode objects need an archiver that can index them. llvm-ar does; the armnto ar needs a plugin.
+find_program(_bb10_llvm_ar NAMES llvm-ar-19 llvm-ar)
+find_program(_bb10_llvm_ranlib NAMES llvm-ranlib-19 llvm-ranlib)
+foreach(_lang C CXX)
+  set(CMAKE_${_lang}_COMPILER_AR "${_bb10_llvm_ar}" CACHE FILEPATH "archiver for LTO objects")
+  set(CMAKE_${_lang}_COMPILER_RANLIB "${_bb10_llvm_ranlib}" CACHE FILEPATH "ranlib for LTO objects")
+endforeach()
